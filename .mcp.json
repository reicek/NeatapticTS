{
  "mcpServers": {
    "neataptic-workflow-mcp": {
      "type": "stdio",
      "command": "node",
      "args": [
        "scripts/agent-customization/mcp/neataptic-workflow-mcp.mjs",
        "--plan=plans/mcp-active-binding.plans.md"
      ]
    },
    "neataptic-validation-mcp": {
      "type": "stdio",
      "command": "node",
      "args": [
        "scripts/agent-customization/mcp/neataptic-validation-mcp.mjs",
        "--plan=plans/mcp-active-binding.plans.md"
      ]
    },
    "neataptic-gate-mcp": {
      "type": "stdio",
      "command": "node",
      "args": ["scripts/agent-customization/mcp/neataptic-gate-mcp.mjs"]
    },
    "neataptic-cortex-mcp": {
      "type": "stdio",
      "command": "node",
      "args": ["scripts/mcp-semantic/repo-cortex-mcp.mjs"],
      "env": {
        "TURSO_DATABASE_URL": "file:./data/turso-replica.sqlite",
        "TURSO_AUTH_TOKEN": "",
        "TURSO_SYNC_URL": "",
        "TURSO_SYNC_INTERVAL": "60"
      }
    },
    "chrome-devtools-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"]
    },
    "neataptic-dispatch-mcp": {
      "type": "stdio",
      "command": "node",
      "args": ["scripts/agent-customization/mcp/neataptic-dispatch-mcp.mjs"]
    }
  },
  "agent": {
    "maxConcurrentAgents": 10
  }
}
