{
  "servers": {
    "neataptic-workflow-mcp": {
      "type": "stdio",
      "command": "node",
      "args": [
        "scripts/agent-customization/mcp/neataptic-workflow-mcp.mjs",
        "--plan=plans/mcp-active-binding.plans.md"
      ]
    },
    "neataptic-validation-mcp": {
      "type": "stdio",
      "command": "node",
      "args": [
        "scripts/agent-customization/mcp/neataptic-validation-mcp.mjs",
        "--plan=plans/mcp-active-binding.plans.md"
      ]
    },
    "neataptic-gate-mcp": {
      "type": "stdio",
      "command": "node",
      "args": ["scripts/agent-customization/mcp/neataptic-gate-mcp.mjs"]
    },
    "cortex": {
      "type": "stdio",
      "command": "node",
      "args": ["scripts/agent-customization/mcp/cortex-facade.mjs"],
      "env": {
        "TURSO_DATABASE_URL": "file:./rag-index/data/turso-replica.sqlite",
        "TURSO_AUTH_TOKEN": "",
        "TURSO_SYNC_URL": "",
        "TURSO_SYNC_INTERVAL": "60"
      }
    },
    "devtools": {
      "type": "stdio",
      "command": "node",
      "args": ["scripts/agent-customization/mcp/devtools-facade.mjs"]
    },
    "neataptic-dispatch-mcp": {
      "type": "stdio",
      "command": "node",
      "args": ["scripts/agent-customization/mcp/neataptic-dispatch-mcp.mjs"]
    }
  }
}
