#!/bin/sh
# Post-commit hook: re-index changed corpus files for the Cortex RAG index.
# This hook is tracked under rag-index/git-hooks/ so it survives clones.
# Install with: git config core.hooksPath rag-index/git-hooks
# It runs synchronously after the commit and always exits 0 so it never blocks git.
node rag-index/auto-reindex.mjs || true
exit 0
